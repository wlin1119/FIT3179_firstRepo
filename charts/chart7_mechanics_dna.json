
{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Interactive connected-dot plot of board-game mechanic prevalence across publication eras.",
  "background": "#FFFFFF",

  "title": {
    "text": "Which Game Mechanics Have Risen or Fallen?",
    "subtitle": "Changes in the share of games using each mechanic across publication eras",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#17324D",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 14,
    "subtitleColor": "#64748B",
    "offset": 20
  },

  "width": 1055,
  "height": 600,

  "padding": {
    "left": 10,
    "right": 25,
    "top": 20,
    "bottom": 20
  },

  "autosize": "pad",

  "signals": [
    {
      "name": "visibleMechanics",
      "value": 20,
      "bind": {
        "input": "range",
        "min": 10,
        "max": 40,
        "step": 5,
        "name": "Mechanics shown: "
      }
    },
    {
      "name": "selectedMechanic",
      "value": null,
      "on": [
        {
          "events": "@mechanicDots:click",
          "update": "selectedMechanic === datum.mechanic ? null : datum.mechanic"
        },
        {
          "events": "@mechanicLines:click",
          "update": "selectedMechanic === datum.mechanic ? null : datum.mechanic"
        },
        {
          "events": "view:click[!event.item]",
          "update": "null"
        }
      ]
    },
    {
      "name": "hoveredMechanic",
      "value": null,
      "on": [
        {
          "events": "@mechanicDots:mouseover",
          "update": "datum.mechanic"
        },
        {
          "events": "@mechanicDots:mouseout",
          "update": "null"
        },
        {
          "events": "@mechanicLines:mouseover",
          "update": "datum.mechanic"
        },
        {
          "events": "@mechanicLines:mouseout",
          "update": "null"
        }
      ]
    },
    
{
  "name": "selectedEra",
  "value": "All",
  "bind": {
    "input": "select",
    "name": "Publication era: ",
    "options": [
      "All",
      "Before 1980",
      "1980-1999",
      "2000-2009",
      "2010-2019",
      "2020 Onwards"
    ],
    "labels": [
      "All eras",
      "Before 1980",
      "1980–1999",
      "2000–2009",
      "2010–2019",
      "2020 Onwards"
    ]
  }
}

  ],

  "data": [
    {
      "name": "raw",
      "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart8_mechanics_dna.csv",
      "format": {
        "type": "csv",
        "parse": {
          "games_with_mechanic": "number",
          "total_games_in_era": "number",
          "percentage": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.era) && isValid(datum.mechanic) && isValid(toNumber(datum.percentage))"
        },
        {
          "type": "formula",
          "as": "percentageValue",
          "expr": "toNumber(datum.percentage)"
        },
        {
          "type": "formula",
          "as": "eraOrder",
          "expr": "datum.era === 'Before 1980' ? 0 : datum.era === '1980-1999' ? 1 : datum.era === '2000-2009' ? 2 : datum.era === '2010-2019' ? 3 : datum.era === '2020 Onwards' ? 4 : 99"
        },
        {
          "type": "filter",
          "expr": "datum.eraOrder < 5"
        }
      ]
    },
    {
      "name": "mechanicRanking",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["mechanic"],
          "fields": ["games_with_mechanic"],
          "ops": ["sum"],
          "as": ["totalMechanicGames"]
        },
        {
          "type": "collect",
          "sort": {
            "field": "totalMechanicGames",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["mechanicRank"]
        },
        {
          "type": "filter",
          "expr": "datum.mechanicRank <= visibleMechanics"
        }
      ]
    },
    {
      "name": "plotData",
      "source": "raw",
      "transform": [
        {
          "type": "lookup",
          "from": "mechanicRanking",
          "key": "mechanic",
          "fields": ["mechanic"],
          "values": ["mechanicRank"],
          "as": ["mechanicRank"]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.mechanicRank)"
        },
        
{
  "type": "filter",
  "expr": "selectedEra === 'All' || datum.era === selectedEra"
},
        {
          "type": "collect",
          "sort": {
            "field": ["mechanicRank", "eraOrder"],
            "order": ["ascending", "ascending"]
          }
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "plotData",
        "field": "percentageValue"
      },
      "nice": true,
      "zero": true,
      "range": "width"
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "mechanicRanking",
        "field": "mechanic",
        "sort": {
          "field": "totalMechanicGames",
          "order": "descending"
        }
      },
      "range": "height",
      "paddingInner": 0.4,
      "paddingOuter": 0.2
    },
    {
      "name": "eraColor",
      "type": "ordinal",
      "domain": [
        "Before 1980",
        "1980-1999",
        "2000-2009",
        "2010-2019",
        "2020 Onwards"
      ],
      "range": [
        "#86B9E3",
        "#3677A8",
        "#45A598",
        "#2878B9",
        "#17324D"
      ]
    }
  ],

  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "title": "Share of games using the mechanic (%)",
      "grid": true,
      "gridColor": "#E5EDF5",
      "gridOpacity": 1,
      "labelFont": "DM Sans",
      "labelFontSize": 14,
      "titleFont": "Manrope",
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "titlePadding": 14,
      "titleColor": "#102A4C",
      "labelColor": "#526F92",
      "domainColor": "#CBD5E1",
      "tickColor": "#CBD5E1",
      "format": ".1f"
    },
    {
      "orient": "left",
      "scale": "y",
      "title": null,
      "labelFont": "DM Sans",
      "labelFontSize": 14,
      "labelLimit": 260,
      "labelColor": "#526F92",
      "domain": false,
      "ticks": false,
      "labelPadding": 14
    }
  ],

  "marks": [
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "mechanicSeries",
          "data": "plotData",
          "groupby": ["mechanic"]
        }
      },
      "marks": [
        {
          "type": "line",
          "name": "mechanicLines",
          "from": {
            "data": "mechanicSeries"
          },
          "encode": {
            "enter": {
              "cursor": {
                "value": "pointer"
              }
            },
            "update": {
              "x": {
                "scale": "x",
                "field": "percentageValue"
              },
              "y": {
                "scale": "y",
                "field": "mechanic",
                "band": 0.5
              },
              "stroke": {
                "signal": "datum.mechanic === selectedMechanic || datum.mechanic === hoveredMechanic ? '#D19A32' : scale('eraColor', datum.era)"
              },
              "strokeWidth": {
                "signal": "datum.mechanic === selectedMechanic || datum.mechanic === hoveredMechanic ? 5 : 3"
              },
              "strokeOpacity": {
                "signal": "selectedMechanic === null && hoveredMechanic === null ? 0.95 : datum.mechanic === selectedMechanic || datum.mechanic === hoveredMechanic ? 1 : 0.2"
              },
              "interpolate": {
                "value": "linear"
              },
              "tooltip": {
                "signal": "{'Mechanic': datum.mechanic, 'Era': datum.era, 'Share of games': format(datum.percentageValue, '.2f') + '%'}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "symbol",
      "name": "mechanicDots",
      "from": {
        "data": "plotData"
      },
      "encode": {
        "enter": {
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "x": {
            "scale": "x",
            "field": "percentageValue"
          },
          "y": {
            "scale": "y",
            "field": "mechanic",
            "band": 0.5
          },
          "size": {
            "signal": "datum.mechanic === selectedMechanic || datum.mechanic === hoveredMechanic ? 230 : 145"
          },
          "fill": {
            "signal": "datum.mechanic === selectedMechanic || datum.mechanic === hoveredMechanic ? '#D19A32' : scale('eraColor', datum.era)"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "signal": "datum.mechanic === selectedMechanic || datum.mechanic === hoveredMechanic ? 2.5 : 2"
          },
          "opacity": {
            "signal": "selectedMechanic === null && hoveredMechanic === null ? 1 : datum.mechanic === selectedMechanic || datum.mechanic === hoveredMechanic ? 1 : 0.22"
          },
          "tooltip": {
            "signal": "{'Mechanic': datum.mechanic, 'Era': datum.era, 'Games using mechanic': datum.games_with_mechanic, 'Total games in era': datum.total_games_in_era, 'Share of games': format(datum.percentageValue, '.2f') + '%'}"
          }
        }
      }
    }
  ],

  "legends": [
    {
      "fill": "eraColor",
      "title": "Publication era",
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 5,
      "labelFont": "DM Sans",
      "labelFontSize": 14,
      "titleFont": "Manrope",
      "titleFontSize": 15,
      "titleFontWeight": "bold",
      "titleColor": "#102A4C",
      "labelColor": "#526F92",
      "symbolSize": 160,
      "offset": 25
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans"
  }
}
