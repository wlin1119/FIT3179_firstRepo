{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Interactive circular network of board-game mechanics.",
  
"title": {
  "text": "Which Game Mechanics Are Most Connected?",
  "subtitle": "Explore commonly paired mechanics · Larger nodes appear in more games; thicker lines indicate stronger connections",
  "anchor": "start",
  "font": "Manrope",
  "fontSize": 24,
  "fontWeight": "bold",
  "color": "#17324D",
  "subtitleFont": "DM Sans",
  "subtitleFontSize": 14,
  "subtitleColor": "#64748B",
  "offset": 20
},

  "width": 1300,
  "height": 600,
  "padding": 25,
  "autosize": "pad",
  "signals": [
    {
      "name": "edgeThreshold",
      "value": 20,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 50,
        "step": 1,
        "name": "Minimum connection weight: "
      }
    },
    {
      "name": "circleRadius",
      "update": "min(width, height) / 2 - 100"
    },
    {
      "name": "selectedNode",
      "value": null,
      "on": [
        {
          "events": "@mechanicNodes:click",
          "update": "selectedNode === datum.id ? null : datum.id"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "nodes_raw",
      "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart7_mechanics_nodes.csv",
      "format": {
        "type": "csv",
        "parse": {
          "game_count": "number"
        },
        "delimiter": ","
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.id) && isValid(datum.game_count)"
        }
      ]
    },
    {
      "name": "nodes",
      "source": "nodes_raw",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": "game_count",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "nodeIndex"
          ]
        },
        {
          "type": "formula",
          "as": "angle",
          "expr": "2 * PI * (datum.nodeIndex - 1) / length(data('nodes_raw')) - PI / 2"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "width / 2 + circleRadius * cos(datum.angle)"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "height / 2 + circleRadius * sin(datum.angle)"
        }
      ]
    },
    {
      "name": "edges_raw",
      "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart7_mechanics_edges.csv",
      "format": {
        "type": "csv",
        "parse": {
          "weight": "number"
        },
        "delimiter": ","
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.source) && isValid(datum.target) && isValid(datum.weight)"
        }
      ]
    },
    {
      "name": "edges",
      "source": "edges_raw",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.weight >= edgeThreshold"
        },
        {
          "type": "lookup",
          "from": "nodes",
          "key": "id",
          "fields": [
            "source"
          ],
          "values": [
            "x",
            "y"
          ],
          "as": [
            "sourceX",
            "sourceY"
          ]
        },
        {
          "type": "lookup",
          "from": "nodes",
          "key": "id",
          "fields": [
            "target"
          ],
          "values": [
            "x",
            "y"
          ],
          "as": [
            "targetX",
            "targetY"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.sourceX) && isValid(datum.targetX)"
        }
      ]
    },
    {
      "name": "selectedEdges",
      "source": "edges",
      "transform": [
        {
          "type": "filter",
          "expr": "selectedNode !== null && (datum.source === selectedNode || datum.target === selectedNode)"
        }
      ]
    },
    {
      "name": "connectedNodeIds",
      "source": "selectedEdges",
      "transform": [
        {
          "type": "fold",
          "fields": [
            "source",
            "target"
          ],
          "as": [
            "endpoint",
            "id"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.id !== selectedNode"
        },
        {
          "type": "aggregate",
          "groupby": [
            "id"
          ]
        }
      ]
    },
    {
      "name": "labels",
      "source": "nodes"
    }
  ],
  "scales": [
    {
      "name": "nodeSize",
      "type": "sqrt",
      "domain": {
        "data": "nodes",
        "field": "game_count"
      },
      "range": [
        35,
        650
      ],
      "zero": true
    },
    {
      "name": "nodeColor",
      "type": "linear",
      "domain": {
        "data": "nodes",
        "field": "game_count"
      },
      "range": [
        "#A8CCE8",
        "#17324D"
      ],
      "clamp": true
    },
    {
      "name": "edgeWidth",
      "type": "sqrt",
      "domain": {
        "data": "edges_raw",
        "field": "weight"
      },
      "range": [
        0.5,
        3.5
      ],
      "zero": true
    },
    {
      "name": "edgeOpacity",
      "type": "linear",
      "domain": {
        "data": "edges_raw",
        "field": "weight"
      },
      "range": [
        0.12,
        0.65
      ],
      "clamp": true
    }
  ],
  "marks": [
    {
      "type": "rule",
      "name": "connections",
      "from": {
        "data": "edges"
      },
      "encode": {
        "update": {
          "x": {
            "field": "sourceX"
          },
          "y": {
            "field": "sourceY"
          },
          "x2": {
            "field": "targetX"
          },
          "y2": {
            "field": "targetY"
          },
          "stroke": {
            "signal": "selectedNode === null ? '#75A9D4' : (datum.source === selectedNode || datum.target === selectedNode ? '#E9B44C' : '#CBD5E1')"
          },
          "strokeWidth": {
            "scale": "edgeWidth",
            "field": "weight"
          },
          "strokeOpacity": {
            "signal": "selectedNode === null ? scale('edgeOpacity', datum.weight) : (datum.source === selectedNode || datum.target === selectedNode ? 1 : 0.06)"
          },
          "tooltip": {
            "signal": "{'Mechanic 1': datum.source, 'Mechanic 2': datum.target, 'Connection weight': datum.weight}"
          }
        },
        "hover": {
          "stroke": {
            "value": "#E9B44C"
          },
          "strokeOpacity": {
            "value": 1
          },
          "strokeWidth": {
            "value": 4
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "mechanicNodes",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "scale": "nodeSize",
            "field": "game_count"
          },
          "fill": {
            "signal": "selectedNode === null ? scale('nodeColor', datum.game_count) : (datum.id === selectedNode ? '#E9B44C' : (indata('connectedNodeIds', 'id', datum.id) ? '#58A89C' : '#D8E1EA'))"
          },
          "stroke": {
            "signal": "datum.id === selectedNode ? '#17324D' : '#FFFFFF'"
          },
          "strokeWidth": {
            "signal": "datum.id === selectedNode ? 3 : (indata('connectedNodeIds', 'id', datum.id) ? 2 : 1)"
          },
          "opacity": {
            "signal": "selectedNode === null || datum.id === selectedNode || indata('connectedNodeIds', 'id', datum.id) ? 1 : 0.2"
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Mechanic': datum.id, 'Games using this mechanic': datum.game_count, 'Status': datum.id === selectedNode ? 'Selected' : (indata('connectedNodeIds', 'id', datum.id) ? 'Connected mechanic' : 'Click to explore')}"
          }
        },
        "hover": {
          "stroke": {
            "value": "#E9B44C"
          },
          "strokeWidth": {
            "value": 3
          }
        }
      }
    },
    {
      "type": "text",
      "name": "mechanicLabels",
      "from": {
        "data": "labels"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x + 12 * cos(datum.angle)"
          },
          "y": {
            "signal": "datum.y + 12 * sin(datum.angle)"
          },
          "text": {
            "field": "id"
          },
          "angle": {
            "signal": "datum.angle * 180 / PI + (cos(datum.angle) < 0 ? 180 : 0)"
          },
          "align": {
            "signal": "cos(datum.angle) >= 0 ? 'left' : 'right'"
          },
          "baseline": {
            "value": "middle"
          },
          
"font": {
  "value": "DM Sans"
},
"fontSize": {
  "value": 12
}
,
          "fontWeight": {
            "signal": "datum.id === selectedNode || datum.game_count >= 700 ? 'bold' : 'normal'"
          },
          "fill": {
            "value": "#17324D"
          },
          "limit": {
            "value": 180
          }
        }
      }
    }
  ],
  "config": {
    "background": "#F8FAFC",
    "view": {
      "stroke": null
    }
  }
}