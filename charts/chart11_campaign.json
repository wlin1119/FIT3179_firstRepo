
{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Interactive dot-density map of Kickstarter board-game campaigns by project country.",
  "width": 850,
  "height": 520,
  "padding": {
    "top": 15,
    "left": 15,
    "right": 15,
    "bottom": 20
  },
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "background": "#F8FAFC",

  "title": {
    "text": "Where Are Board-Game Campaigns Concentrated?",
    "subtitle": "Kickstarter campaigns by project country · Each dot represents approximately 25 campaigns",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#17324D",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 14,
    "subtitleColor": "#64748B",
    "offset": 20
  },

  "signals": [
    {
      "name": "campaignFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "Campaign range: ",
        "options": [
          "All",
          "1–19",
          "20–99",
          "100–499",
          "500–1,999",
          "2,000+"
        ],
        "labels": [
          "All countries",
          "1–19 campaigns",
          "20–99 campaigns",
          "100–499 campaigns",
          "500–1,999 campaigns",
          "2,000+ campaigns"
        ]
      }
    },
    {
      "name": "hoveredCountry",
      "value": null,
      "on": [
        {
          "events": "@dots:pointerover",
          "update": "datum.country"
        },
        {
          "events": "@dots:pointerout",
          "update": "null"
        }
      ]
    },
    {
      "name": "selectedCountry",
      "value": null,
      "on": [
        {
          "events": "@dots:click",
          "update": "selectedCountry === datum.country ? null : datum.country"
        },
        {
          "events": "@baseMap:click",
          "update": "null"
        },
        {
          "events": "@resetMap:click",
          "update": "null"
        }
      ]
    },
    {
      "name": "zoom",
      "value": 1,
      "on": [
        {
          "events": {
            "type": "wheel",
            "consume": true
          },
          "update": "clamp(zoom * pow(1.0015, -event.deltaY * pow(16, event.deltaMode)), 1, 12)"
        },
        {
          "events": "@zoomIn:click",
          "update": "clamp(zoom * 1.4, 1, 12)"
        },
        {
          "events": "@zoomOut:click",
          "update": "clamp(zoom / 1.4, 1, 12)"
        },
        {
          "events": "@resetMap:click",
          "update": "1"
        }
      ]
    },
    {
      "name": "dragStart",
      "value": null,
      "on": [
        {
          "events": "@baseMap:pointerdown, @dots:pointerdown",
          "update": "[x(), y(), panX, panY]"
        },
        {
          "events": "window:pointerup",
          "update": "null"
        },
        {
          "events": "@resetMap:click",
          "update": "null"
        }
      ]
    },
    {
      "name": "panX",
      "value": 0,
      "on": [
        {
          "events": "window:pointermove",
          "update": "dragStart ? dragStart[2] + x() - dragStart[0] : panX"
        },
        {
          "events": "@resetMap:click",
          "update": "0"
        }
      ]
    },
    {
      "name": "panY",
      "value": 0,
      "on": [
        {
          "events": "window:pointermove",
          "update": "dragStart ? dragStart[3] + y() - dragStart[1] : panY"
        },
        {
          "events": "@resetMap:click",
          "update": "0"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "world",
      "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_admin_0_countries"
      }
    },
    {
      "name": "campaignDots",
      "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart11_campaign_dots.csv",
      "format": {
        "type": "csv",
        "parse": {
          "campaign_count": "number",
          "dot_count": "number",
          "longitude": "number",
          "latitude": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.longitude) && isValid(datum.latitude) && isValid(datum.campaign_count)"
        },
        {
          "type": "formula",
          "as": "category",
          "expr": "datum.campaign_count >= 2000 ? '2,000+' : datum.campaign_count >= 500 ? '500–1,999' : datum.campaign_count >= 100 ? '100–499' : datum.campaign_count >= 20 ? '20–99' : '1–19'"
        },
        {
          "type": "formula",
          "as": "countryName",
          "expr": "datum.country === 'US' ? 'United States' : datum.country === 'GB' ? 'United Kingdom' : datum.country === 'CA' ? 'Canada' : datum.country === 'AU' ? 'Australia' : datum.country === 'FR' ? 'France' : datum.country === 'DE' ? 'Germany' : datum.country === 'NL' ? 'Netherlands' : datum.country === 'ES' ? 'Spain' : datum.country === 'IT' ? 'Italy' : datum.country === 'NZ' ? 'New Zealand' : datum.country === 'SE' ? 'Sweden' : datum.country === 'NO' ? 'Norway' : datum.country === 'IE' ? 'Ireland' : datum.country === 'BE' ? 'Belgium' : datum.country === 'CH' ? 'Switzerland' : datum.country === 'DK' ? 'Denmark' : datum.country === 'AT' ? 'Austria' : datum.country === 'MX' ? 'Mexico' : datum.country === 'HK' ? 'Hong Kong' : datum.country === 'SG' ? 'Singapore' : datum.country"
        },
        {
          "type": "filter",
          "expr": "campaignFilter === 'All' || datum.category === campaignFilter"
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["longitude", "latitude"],
          "as": ["x", "y"]
        }
      ]
    }
  ],

  "projections": [
    {
      "name": "projection",
      "type": "equalEarth",
      "scale": {
        "signal": "155 * zoom"
      },
      "translate": {
        "signal": "[width / 2 + panX, height / 2 + panY]"
      }
    }
  ],

  "marks": [
    {
      "name": "baseMap",
      "type": "shape",
      "from": {
        "data": "world"
      },
      "clip": true,
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ],
      "encode": {
        "enter": {
          "fill": {
            "value": "#E5E7EB"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 0.7
          },
          "cursor": {
            "value": "grab"
          }
        },
        "hover": {
          "fill": {
            "value": "#D8E6F2"
          }
        }
      }
    },
    {
      "name": "dots",
      "type": "symbol",
      "from": {
        "data": "campaignDots"
      },
      "clip": true,
      "encode": {
        "enter": {
          "shape": {
            "value": "circle"
          },
          "size": {
            "value": 36
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "hoveredCountry === datum.country ? 54 : 36"
          },
          "fill": {
            "signal": "selectedCountry === datum.country ? '#D19A32' : hoveredCountry === datum.country ? '#17324D' : '#2878B9'"
          },
          "fillOpacity": {
            "signal": "selectedCountry === null || selectedCountry === datum.country ? 0.85 : 0.16"
          },
          "stroke": {
            "signal": "selectedCountry === datum.country ? '#17324D' : '#FFFFFF'"
          },
          "strokeWidth": {
            "signal": "selectedCountry === datum.country ? 1.2 : 0.45"
          },
          "tooltip": {
            "signal": "{'Country': datum.countryName, 'Total campaigns': format(datum.campaign_count, ',d'), 'Dots for country': format(datum.dot_count, ',d'), 'Campaign range': datum.category, 'Dot representation': 'Approximately 25 campaigns', 'Location': 'Illustrative within country'}"
          }
        }
      }
    },
    {
      "name": "legendDot",
      "type": "symbol",
      "encode": {
        "enter": {
          "x": {
            "value": 25
          },
          "y": {
            "signal": "height - 25"
          },
          "shape": {
            "value": "circle"
          },
          "size": {
            "value": 65
          },
          "fill": {
            "value": "#2878B9"
          },
          "fillOpacity": {
            "value": 0.85
          },
          "stroke": {
            "value": "#FFFFFF"
          }
        }
      }
    },
    {
      "name": "legendText",
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 40
          },
          "y": {
            "signal": "height - 25"
          },
          "text": {
            "value": "1 dot ≈ 25 campaigns"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#17324D"
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "name": "noteText",
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 25
          },
          "y": {
            "signal": "height - 8"
          },
          "text": {
            "value": "Dots are illustrative, not actual campaign locations."
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#64748B"
          }
        }
      }
    },
    {
      "name": "resetMap",
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width - 95"
          },
          "y": {
            "value": 20
          },
          "text": {
            "value": "Reset"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#526F92"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "hover": {
          "fill": {
            "value": "#2878B9"
          }
        }
      }
    },
    {
      "name": "zoomIn",
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width - 50"
          },
          "y": {
            "value": 20
          },
          "text": {
            "value": "+"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 22
          },
          "fontWeight": {
            "value": "bold"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#102A4C"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "hover": {
          "fill": {
            "value": "#2878B9"
          }
        }
      }
    },
    {
      "name": "zoomOut",
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width - 20"
          },
          "y": {
            "value": 20
          },
          "text": {
            "value": "−"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 22
          },
          "fontWeight": {
            "value": "bold"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#102A4C"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "hover": {
          "fill": {
            "value": "#2878B9"
          }
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans"
  }
}
