
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Interactive box plot comparing board-game player ratings across mechanic-count groups.",
  "background": "#F8FAFC",

  "title": {
    "text": "Do More Mechanics Mean Better Ratings?",
    "subtitle": "Distribution of average player ratings by number of game mechanics",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 23,
    "fontWeight": "bold",
    "color": "#17324D",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 14,
    "subtitleColor": "#64748B",
    "offset": 20
  },

  "width": 720,
  "height": 353,

  "data": {
    "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart11_mechanics_rating.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year_published": "number",
        "mechanic_count": "number",
        "average_rating": "number",
        "users_rated": "number"
      }
    }
  },

  "params": [
    {
      "name": "minimumRatings",
      "value": 100,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 5000,
        "step": 100,
        "name": "Minimum user ratings: "
      }
    },
    {
      "name": "selectedEra",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "Publication era: ",
        "options": [
          "All",
          "Before 1980",
          "1980–1999",
          "2000–2009",
          "2010–2019",
          "2020 Onwards"
        ],
        "labels": [
          "All eras",
          "Before 1980",
          "1980–1999",
          "2000–2009",
          "2010–2019",
          "2020 Onwards"
        ]
      }
    }
  ],

  "transform": [
    {
      "filter": "isValid(datum.mechanic_count) && isValid(datum.average_rating) && isValid(datum.users_rated)"
    },
    {
      "filter": "datum.mechanic_count > 0 && datum.average_rating >= 0 && datum.average_rating <= 10"
    },
    {
      "filter": "datum.users_rated >= minimumRatings"
    },
    {
      "filter": "selectedEra === 'All' || datum.era === selectedEra"
    },
    {
      "calculate": "datum.mechanic_count <= 2 ? '1–2' : datum.mechanic_count <= 4 ? '3–4' : datum.mechanic_count <= 6 ? '5–6' : '7+'",
      "as": "mechanic_group"
    }
  ],

  "mark": {
    "type": "boxplot",
    "extent": 1.5,
    "size": 90,
    "box": {
      "stroke": "#17324D",
      "strokeWidth": 1.5
    },
    "median": {
      "color": "#FFFFFF",
      "strokeWidth": 3
    },
    "rule": {
      "color": "#526F92",
      "strokeWidth": 1.5
    },
    "ticks": {
      "color": "#526F92",
      "strokeWidth": 1.5
    },
    "outliers": {
      "opacity": 0.2,
      "size": 14,
      "color": "#64748B"
    }
  },

  "encoding": {
    "x": {
      "field": "mechanic_group",
      "type": "ordinal",
      "title": "Number of Game Mechanics",
      "sort": ["1–2", "3–4", "5–6", "7+"],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 14,
        "titleFontSize": 15,
        "titlePadding": 15
      }
    },
    "y": {
      "field": "average_rating",
      "type": "quantitative",
      "title": "Average User Rating (0–10)",
      "scale": {
        "domain": [0, 10]
      },
      "axis": {
        "labelFontSize": 13,
        "titleFontSize": 15,
        "titlePadding": 15
      }
    },
    "color": {
      "field": "mechanic_group",
      "type": "nominal",
      "scale": {
        "domain": ["1–2", "3–4", "5–6", "7+"],
        "range": [
          "#A8CCE8",
          "#3677A8",
          "#58A89C",
          "#17324D"
        ]
      },
      "legend": null
    }
  },

  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#526F92",
      "titleColor": "#17324D",
      "domainColor": "#CBD5E1",
      "tickColor": "#CBD5E1",
      "gridColor": "#E2E8F0",
      "gridOpacity": 0.65,
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}
