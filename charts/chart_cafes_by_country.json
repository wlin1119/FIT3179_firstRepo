
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 850,
  "height": 450,
  "title": {
    "text": "Where Are Board-Game Cafés Found?",
    "subtitle": "Proportional circles show recorded café counts by country",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 25,
    "fontWeight": 800,
    "color": "#102A4C",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 14,
    "subtitleColor": "#526F92",
    "offset": 18
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EAF3FB",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart9_cafe_count_by_country_with_coords.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.cafe_count)",
          "as": "cafes"
        },
        {
          "calculate": "toNumber(datum.latitude)",
          "as": "lat"
        },
        {
          "calculate": "toNumber(datum.longitude)",
          "as": "lon"
        },
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon) && isValid(datum.cafes)"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "color": "#2878B9",
        "stroke": "#102A4C",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "cafes",
          "type": "quantitative",
          "title": "Recorded cafés",
          "scale": {
            "type": "sqrt",
            "domain": [1, 249],
            "range": [15, 1500]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFont": "Manrope",
            "titleFontSize": 13,
            "labelFont": "DM Sans",
            "labelFontSize": 12,
            "values": [1, 25, 100, 249]
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "cafes",
            "type": "quantitative",
            "title": "Recorded cafés",
            "format": ",.0f"
          },
          {
            "field": "lat",
            "type": "quantitative",
            "title": "Latitude",
            "format": ".2f"
          },
          {
            "field": "lon",
            "type": "quantitative",
            "title": "Longitude",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    }
  }
}
