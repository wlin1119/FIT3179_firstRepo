{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Long Do Board Games Take to Play?",
    "subtitle": "Share of games in each playing-time range, grouped by publication era",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#17324D",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#64748B",
    "offset": 16
  },
  "width": 650,
  "height": 263,
  "background": "#F8FAFC",
  "padding": {"left": 10, "right": 15, "top": 10, "bottom": 5},
  "data": {
    "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart3_playing_time.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": "isValid(datum.playing_time) && toNumber(datum.playing_time) > 0 && isValid(datum.era)"
    },
    {
      "calculate": "datum.playing_time <= 30 ? '0–30 min' : datum.playing_time <= 60 ? '31–60 min' : datum.playing_time <= 90 ? '61–90 min' : datum.playing_time <= 120 ? '91–120 min' : datum.playing_time <= 180 ? '121–180 min' : 'Over 180 min'",
      "as": "time_range"
    },
    {
      "aggregate": [{"op": "count", "as": "game_count"}],
      "groupby": ["era", "time_range"]
    },
    {
      "joinaggregate": [
        {"op": "sum", "field": "game_count", "as": "era_total"}
      ],
      "groupby": ["era"]
    },
    {"calculate": "datum.game_count / datum.era_total", "as": "era_percentage"}
  ],
  "mark": {
    "type": "rect",
    "stroke": "#FFFFFF",
    "strokeWidth": 3,
    "cornerRadius": 2,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "time_range",
      "type": "ordinal",
      "title": "Estimated Playing Time",
      "sort": [
        "0–30 min",
        "31–60 min",
        "61–90 min",
        "91–120 min",
        "121–180 min",
        "Over 180 min"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFont": "Arial",
        "labelFontSize": 11,
        "labelColor": "#475569",
        "titleFont": "Arial",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titleColor": "#17324D",
        "labelPadding": 8,
        "titlePadding": 14,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "era",
      "type": "ordinal",
      "title": "Publication Era",
      "sort": [
        "Before 1980",
        "1980-1999",
        "2000-2009",
        "2010-2019",
        "2020 Onwards"
      ],
      "axis": {
        "labelFont": "Arial",
        "labelFontSize": 12,
        "labelColor": "#475569",
        "titleFont": "Arial",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titleColor": "#17324D",
        "labelPadding": 8,
        "titlePadding": 12,
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "era_percentage",
      "type": "quantitative",
      "title": "Share of Games",
      "scale": {
        "domain": [0, 0.5],
        "clamp": true,
        "range": [
          "#EFF6FF",
          "#D5E6F7",
          "#A8CCE8",
          "#75A9D4",
          "#3677A8",
          "#17324D"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 260,
        "gradientThickness": 14,
        "format": ".0%",
        "titleFont": "Arial",
        "titleFontSize": 11,
        "titleFontWeight": "bold",
        "titleColor": "#17324D",
        "labelFont": "Arial",
        "labelFontSize": 10,
        "labelColor": "#475569",
        "offset": 12
      }
    },
    "tooltip": [
      {"field": "era", "type": "nominal", "title": "Publication Era"},
      {"field": "time_range", "type": "ordinal", "title": "Playing Time"},
      {
        "field": "game_count",
        "type": "quantitative",
        "title": "Number of Games",
        "format": ","
      },
      {
        "field": "era_percentage",
        "type": "quantitative",
        "title": "Share of Games",
        "format": ".1%"
      }
    ]
  },
  "config": {"view": {"stroke": null}, "axis": {"grid": false}, "font": "Arial"}
}