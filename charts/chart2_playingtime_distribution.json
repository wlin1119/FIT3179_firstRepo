
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "How Long Do Board Games Take to Play?",
    "subtitle": "Share of games by playing time across publication eras",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#102A4C",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 14,
    "subtitleColor": "#526F92",
    "offset": 20
  },

  "width": 650,
  "height": 378,

  "background": "#FFFFFF",

  "padding": {
    "left": 10,
    "right": 15,
    "top": 12,
    "bottom": 10
  },

  "data": {
    "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart3_playing_time.csv",
    "format": {
      "type": "csv",
      "parse": {
        "playing_time": "number"
      }
    }
  },

  "transform": [
    {
      "filter": "isValid(datum.playing_time) && datum.playing_time > 0 && isValid(datum.era)"
    },
    {
      "calculate": "datum.playing_time <= 30 ? '0–30 min' : datum.playing_time <= 60 ? '31–60 min' : datum.playing_time <= 90 ? '61–90 min' : datum.playing_time <= 120 ? '91–120 min' : datum.playing_time <= 180 ? '121–180 min' : 'Over 180 min'",
      "as": "time_range"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "game_count"
        }
      ],
      "groupby": [
        "era",
        "time_range"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "game_count",
          "as": "era_total"
        }
      ],
      "groupby": [
        "era"
      ]
    },
    {
      "calculate": "datum.game_count / datum.era_total",
      "as": "era_percentage"
    }
  ],

  "mark": {
    "type": "rect",
    "stroke": "#FFFFFF",
    "strokeWidth": 3,
    "cornerRadius": 3,
    "tooltip": true
  },

  "encoding": {
    "x": {
      "field": "time_range",
      "type": "ordinal",
      "title": "Estimated Playing Time",
      "sort": [
        "0–30 min",
        "31–60 min",
        "61–90 min",
        "91–120 min",
        "121–180 min",
        "Over 180 min"
      ],
      "axis": {
        "labelFont": "DM Sans",
        "labelFontSize": 14,
        "labelColor": "#526F92",
        "labelAngle": 0,
        "labelPadding": 10,
        "labelLimit": 115,

        "titleFont": "Manrope",
        "titleFontSize": 16,
        "titleFontWeight": 600,
        "titleColor": "#17324D",
        "titlePadding": 18,

        "domain": false,
        "ticks": false
      }
    },

    "y": {
      "field": "era",
      "type": "ordinal",
      "title": "Publication Era",
      "sort": [
        "Before 1980",
        "1980-1999",
        "2000-2009",
        "2010-2019",
        "2020 Onwards"
      ],
      "axis": {
        "labelFont": "DM Sans",
        "labelFontSize": 14,
        "labelColor": "#526F92",
        "labelPadding": 10,

        "titleFont": "Manrope",
        "titleFontSize": 16,
        "titleFontWeight": 600,
        "titleColor": "#17324D",
        "titlePadding": 18,

        "domain": false,
        "ticks": false
      }
    },

    "color": {
      "field": "era_percentage",
      "type": "quantitative",
      "title": "Share of Games",
      "scale": {
        "domain": [0, 0.5],
        "range": [
          "#EFF6FF",
          "#D5E6F7",
          "#A8CCE8",
          "#75A9D4",
          "#3677A8",
          "#17324D"
        ]
      },

      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 300,
        "gradientThickness": 15,
        "format": ".0%",

        "titleFont": "Manrope",
        "titleFontSize": 15,
        "titleFontWeight": 600,
        "titleColor": "#17324D",

        "labelFont": "DM Sans",
        "labelFontSize": 13,
        "labelColor": "#526F92",

        "offset": 20,
        "titlePadding": 10
      }
    },

    "tooltip": [
      {
        "field": "era",
        "type": "nominal",
        "title": "Publication Era"
      },
      {
        "field": "time_range",
        "type": "ordinal",
        "title": "Playing Time"
      },
      {
        "field": "game_count",
        "type": "quantitative",
        "title": "Number of Games",
        "format": ",d"
      },
      {
        "field": "era_percentage",
        "type": "quantitative",
        "title": "Share of Games",
        "format": ".1%"
      }
    ]
  },

  "config": {
    "font": "DM Sans",

    "view": {
      "stroke": null
    },

    "axis": {
      "grid": false
    },

    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "Manrope"
    }
  }
}
