
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Has the Mix of Game Mechanics Changed?",
    "subtitle": "Share of games by mechanic count across publication eras",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 24,
    "fontWeight": 800,
    "color": "#17324D",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 14,
    "subtitleColor": "#64748B",
    "offset": 20
  },
  "background": "#F8FAFC",
  "data": {
    "url": "https://raw.githubusercontent.com/wlin1119/FIT3179_firstRepo/refs/heads/main/chart3_mechanics_by_era.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.game_id) && isValid(datum.era) && isValid(datum.mechanic_count) && toNumber(datum.mechanic_count) >= 0"
    },
    {
      "calculate": "toNumber(datum.mechanic_count)",
      "as": "mechanics"
    },
    {
      "calculate": "datum.era === 'Before 1980' ? 0 : datum.era === '1980-1999' ? 1 : datum.era === '2000-2009' ? 2 : datum.era === '2010-2019' ? 3 : datum.era === '2020 Onwards' ? 4 : -1",
      "as": "era_order"
    },
    {
      "filter": "datum.era_order >= 0"
    },
    {
      "calculate": "datum.mechanics <= 2 ? 1 : 0",
      "as": "g12"
    },
    {
      "calculate": "datum.mechanics >= 3 && datum.mechanics <= 4 ? 1 : 0",
      "as": "g34"
    },
    {
      "calculate": "datum.mechanics >= 5 && datum.mechanics <= 6 ? 1 : 0",
      "as": "g56"
    },
    {
      "calculate": "datum.mechanics >= 7 ? 1 : 0",
      "as": "g7plus"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "g12",
          "as": "games_12"
        },
        {
          "op": "sum",
          "field": "g34",
          "as": "games_34"
        },
        {
          "op": "sum",
          "field": "g56",
          "as": "games_56"
        },
        {
          "op": "sum",
          "field": "g7plus",
          "as": "games_7plus"
        }
      ],
      "groupby": [
        "era",
        "era_order"
      ]
    },
    {
      "calculate": "datum.games_12 + datum.games_34 + datum.games_56 + datum.games_7plus",
      "as": "era_total"
    },
    {
      "calculate": "round(datum.games_12 / datum.era_total * 100)",
      "as": "cut_12"
    },
    {
      "calculate": "round((datum.games_12 + datum.games_34) / datum.era_total * 100)",
      "as": "cut_34"
    },
    {
      "calculate": "round((datum.games_12 + datum.games_34 + datum.games_56) / datum.era_total * 100)",
      "as": "cut_56"
    },
    {
      "calculate": "sequence(0, 100)",
      "as": "tile_ids"
    },
    {
      "flatten": [
        "tile_ids"
      ],
      "as": [
        "tile"
      ]
    },
    {
      "calculate": "floor(datum.tile % 10)",
      "as": "tile_col"
    },
    {
      "calculate": "9 - floor(datum.tile / 10)",
      "as": "tile_row"
    },
    {
      "calculate": "datum.tile < datum.cut_12 ? '1–2 mechanics' : datum.tile < datum.cut_34 ? '3–4 mechanics' : datum.tile < datum.cut_56 ? '5–6 mechanics' : '7+ mechanics'",
      "as": "mechanic_group"
    },
    {
      "calculate": "datum.mechanic_group === '1–2 mechanics' ? datum.games_12 : datum.mechanic_group === '3–4 mechanics' ? datum.games_34 : datum.mechanic_group === '5–6 mechanics' ? datum.games_56 : datum.games_7plus",
      "as": "group_games"
    },
    {
      "calculate": "datum.group_games / datum.era_total",
      "as": "group_share"
    }
  ],
  "facet": {
    "column": {
      "field": "era",
      "type": "nominal",
      "sort": [
        "Before 1980",
        "1980-1999",
        "2000-2009",
        "2010-2019",
        "2020 Onwards"
      ],
      "header": {
        "title": null,
        "labelFont": "DM Sans",
        "labelFontSize": 16,
        "labelFontWeight": 700,
        "labelColor": "#17324D",
        "labelPadding": 14,
        "labelLimit": 140
      }
    }
  },
  "spec": {
    "width": 300,
    "height": 300,
    "mark": {
      "type": "rect",
      "stroke": "#F8FAFC",
      "strokeWidth": 1.5,
      "cornerRadius": 1
    },
    "encoding": {
      "x": {
        "field": "tile_col",
        "type": "ordinal",
        "sort": "ascending",
        "axis": null,
        "scale": {
          "paddingInner": 0.08,
          "paddingOuter": 0.02
        }
      },
      "y": {
        "field": "tile_row",
        "type": "ordinal",
        "sort": "descending",
        "axis": null,
        "scale": {
          "paddingInner": 0.08,
          "paddingOuter": 0.02
        }
      },
      "color": {
        "field": "mechanic_group",
        "type": "nominal",
        "title": "Mechanics per Game",
        "sort": [
          "1–2 mechanics",
          "3–4 mechanics",
          "5–6 mechanics",
          "7+ mechanics"
        ],
        "scale": {
          "domain": [
            "1–2 mechanics",
            "3–4 mechanics",
            "5–6 mechanics",
            "7+ mechanics"
          ],
          "range": [
            "#A8CCE8",
            "#3677A8",
            "#58A89C",
            "#17324D"
          ]
        },
        "legend": {
          "orient": "bottom",
          "direction": "horizontal",
          "columns": 4,
          "titleFont": "Manrope",
          "titleFontSize": 15,
          "titleFontWeight": 700,
          "titleColor": "#17324D",
          "labelFont": "DM Sans",
          "labelFontSize": 14,
          "labelColor": "#475569",
          "symbolType": "square",
          "symbolSize": 140,
          "offset": 20
        }
      },
      "tooltip": [
        {
          "field": "era",
          "type": "nominal",
          "title": "Publication Era"
        },
        {
          "field": "mechanic_group",
          "type": "nominal",
          "title": "Mechanic Count"
        },
        {
          "field": "group_games",
          "type": "quantitative",
          "title": "Games in Category",
          "format": ",.0f"
        },
        {
          "field": "group_share",
          "type": "quantitative",
          "title": "Share of Era",
          "format": ".1%"
        },
        {
          "field": "era_total",
          "type": "quantitative",
          "title": "Valid Games in Era",
          "format": ",.0f"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "font": "DM Sans",
    "title": {
      "font": "Manrope"
    },
    "facet": {
      "spacing": 22
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "Manrope"
    },
    "view": {
      "stroke": null
    }
  }
}
